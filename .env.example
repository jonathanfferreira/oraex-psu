# ORAEX PSU Manager — Environment Variables
# Copy this file to .env for local development (not committed to git)

# PostgreSQL connection string
# Local dev (matches docker-compose.yml):
DATABASE_URL=postgresql://oraex:oraex@localhost:5432/oraex

# Cloud Run + Cloud SQL Auth Proxy (Unix socket):
# DATABASE_URL=postgresql://oraex:STRONG_PASSWORD@/oraex?host=/cloudsql/oraex-cloud-consulting:southamerica-east1:oraex-psu

# Flask secret key (use a long random string in production)
ORAEX_SECRET_KEY=change-me-in-production

# Flask debug mode (set to false in production)
FLASK_DEBUG=false

# Server port
PORT=5000
